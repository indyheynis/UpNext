{
  "expo": {
    "name": "PlayerHype",
    "slug": "playerhype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.playerhype.app",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Save your PlayerHype poster to your photo library."
      }
    },
    "android": {
      "package": "com.playerhype.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#090C10"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to create your personal sports poster.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Access the photos you choose for PlayerHype.",
          "savePhotosPermission": "Save your PlayerHype poster to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      "expo-router"
    ],
    "scheme": "playerhype"
  }
}